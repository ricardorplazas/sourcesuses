{
  "name": "sourcesuses-garden",
  "description": "The public Sources & Uses private-equity demand-validation site",
  "private": true,
  "version": "4.5.1",
  "type": "module",
  "author": "Sources & Uses",
  "license": "MIT",
  "homepage": "https://ricardorplazas.github.io/sourcesuses/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ricardorplazas/sourcesuses.git"
  },
  "scripts": {
    "quartz": "./quartz/bootstrap-cli.mjs",
    "build": "npx quartz build",
    "docs": "npx quartz build --serve -d docs",
    "check:content": "node scripts/check-public-content.mjs",
    "check:rendered": "node scripts/check-rendered-output.mjs",
    "check:phase1": "node scripts/check-phase1.mjs",
    "inventory:content": "node scripts/generate-content-inventory.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "check": "tsc --noEmit && npx prettier . --check",
    "format": "npx prettier . --write",
    "test": "tsx --test",
    "verify": "npm run check && npm test && npm run check:content && npm run build && npm run check:rendered && npm run check:phase1 && npm run audit:prod",
    "profile": "0x -D prof ./quartz/bootstrap-cli.mjs build --concurrency=1"
  },
  "engines": {
    "npm": ">=10.9.2",
    "node": ">=22"
  },
  "keywords": [
    "private-equity",
    "investment-analysis",
    "digital-garden",
    "finance-education",
    "quartz"
  ],
  "bin": {
    "quartz": "./quartz/bootstrap-cli.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@floating-ui/dom": "^1.7.2",
